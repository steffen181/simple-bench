include README.md LICENSE LICENSE_STATUS.md THIRD_PARTY_NOTICES.md CITATION.cff
recursive-include licenses *.txt
recursive-include docs *.md
recursive-include examples *.json
recursive-include research *.json *.md
recursive-include tests *.py
